# Copy to ".env" on the server and fill in. Never commit the real .env.
# POSTGRES_PASSWORD must be the same as "password" in the Secrets Manager secret routego/notification/db.
POSTGRES_PASSWORD=change-me-strong-password
NOTIFICATION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/675252699468/notification-q
# The queue the email service's bounce and complaint reports arrive on (SES -> SNS -> this queue).
# Like notification-q it must have a dead-letter queue (redrive policy).
EMAIL_SERVICE_REPORTS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/675252699468/email-service-reports
# Must be an email address verified in Amazon SES (ap-south-1).
SENDER_ADDRESS=your-verified-email@example.com
PORTAL_BASE_URL=http://localhost:8080/
